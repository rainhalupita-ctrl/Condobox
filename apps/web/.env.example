# ==============================================================================
# CONFIGURAÇÃO DO FRONTEND PWA (NEXT.JS)
# ==============================================================================

# Supabase (Configuração de Autenticação e Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Endereço da API Local no PC da Portaria (Na mesma rede Wi-Fi / Ethernet)
# Ex: http://192.168.1.100:3001
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:3001
