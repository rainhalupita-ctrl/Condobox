{
  "name": "condobox-desktop",
  "version": "1.0.0",
  "description": "CondoBox Desktop App - Sistema All-in-One de Portaria",
  "main": "src/main.js",
  "author": "CondoBox Tecnologia Condominial",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder && powershell -ExecutionPolicy Bypass -File ./scripts/sign_and_configure.ps1"
  },
  "dependencies": {
    "condo-local-api": "*"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "electron": "32.0.1",
    "electron-builder": "24.13.3",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "appId": "com.condobox.desktop",
    "productName": "CondoBox Portaria",
    "copyright": "Copyright © 2026 CondoBox Tecnologia Condominial",
    "icon": "assets/icon.ico",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "legalTrademarks": "CondoBox",
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "CondoBox Tecnologia Condominial"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "CondoBox Portaria",
      "uninstallDisplayName": "CondoBox Portaria - Sistema de Gestão Condominial",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "node_modules/condo-local-api/**/*"
    ]
  }
}
